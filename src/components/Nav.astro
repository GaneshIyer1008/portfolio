---
import ThemeToggle from './ThemeToggle.astro';
import { withBase } from '../lib/base';

const links = [
  { href: '#about', label: 'About' },
  { href: '#experience', label: 'Experience' },
  { href: '#projects', label: 'Projects' },
  { href: '#publications', label: 'Publications' },
  { href: '#contact', label: 'Contact' },
];
const cv = withBase('cv.pdf');
---

<header class="nav" id="siteNav">
  <div class="container nav-inner">
    <a href="#top" class="brand" aria-label="Back to top">
      <span class="brand-mark">GI</span>
      <span class="brand-name">Ganesh Iyer</span>
    </a>

    <nav class="nav-links" id="navLinks" aria-label="Primary">
      {links.map((l) => <a href={l.href} class="nav-link" data-link={l.href}>{l.label}</a>)}
      <a href={cv} class="nav-link nav-link--cv" target="_blank" rel="noopener">CV</a>
    </nav>

    <div class="nav-actions">
      <ThemeToggle />
      <button class="hamburger" id="hamburger" type="button" aria-label="Toggle menu" aria-expanded="false" aria-controls="navLinks">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--nav-h);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(160%) blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--transition), background var(--transition);
  }
  .nav.scrolled {
    border-bottom-color: var(--border);
    box-shadow: var(--shadow-sm);
  }
  .nav-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--fg-strong);
    font-family: var(--font-display);
    font-weight: 600;
  }
  .brand-mark {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 9px;
    background: var(--accent);
    color: var(--accent-contrast);
    font-size: 0.85rem;
    letter-spacing: 0.02em;
  }
  .brand-name { font-size: 1rem; }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .nav-link {
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 500;
    padding: 0.45rem 0.7rem;
    border-radius: 8px;
    transition: color var(--transition), background var(--transition);
  }
  .nav-link:hover { color: var(--fg-strong); background: var(--accent-soft); }
  .nav-link.active { color: var(--accent); }
  .nav-link--cv {
    margin-left: 0.35rem;
    border: 1px solid var(--border-strong);
    color: var(--fg-strong);
  }
  .nav-link--cv:hover { border-color: var(--accent); color: var(--accent); background: transparent; }

  .nav-actions { display: flex; align-items: center; gap: 0.6rem; }

  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 38px;
    height: 38px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--bg-elev);
    cursor: pointer;
  }
  .hamburger span {
    display: block;
    width: 17px;
    height: 2px;
    margin-inline: auto;
    background: var(--fg);
    border-radius: 2px;
    transition: transform var(--transition), opacity var(--transition);
  }

  @media (max-width: 760px) {
    .brand-name { display: none; }
    .hamburger { display: flex; }
    .nav-link--cv { display: none; }
    .nav-links {
      position: absolute;
      top: var(--nav-h);
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0.5rem clamp(1.1rem, 4vw, 2rem) 1rem;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      box-shadow: var(--shadow-md);
      transform: translateY(-130%);
      opacity: 0;
      pointer-events: none;
      transition: transform 0.28s ease, opacity 0.28s ease;
    }
    .nav.open .nav-links { transform: translateY(0); opacity: 1; pointer-events: auto; }
    .nav-link { padding: 0.8rem 0.5rem; font-size: 1rem; border-bottom: 1px solid var(--border); }
    .nav.open .hamburger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .nav.open .hamburger span:nth-child(2) { opacity: 0; }
    .nav.open .hamburger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  }
</style>

<script>
  const nav = document.getElementById('siteNav');
  const hamburger = document.getElementById('hamburger');
  const navLinks = document.getElementById('navLinks');

  // Mobile menu toggle
  hamburger?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open');
    hamburger.setAttribute('aria-expanded', String(!!open));
  });
  navLinks?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      nav?.classList.remove('open');
      hamburger?.setAttribute('aria-expanded', 'false');
    })
  );

  // Shadow/border once scrolled
  const onScroll = () => nav?.classList.toggle('scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Scrollspy: highlight the link of the section in view
  const linkFor = new Map<string, Element>();
  document.querySelectorAll('[data-link]').forEach((el) => {
    const id = el.getAttribute('data-link')?.slice(1);
    if (id) linkFor.set(id, el);
  });
  const spy = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          linkFor.forEach((el) => el.classList.remove('active'));
          linkFor.get(entry.target.id)?.classList.add('active');
        }
      });
    },
    { rootMargin: '-45% 0px -50% 0px' }
  );
  linkFor.forEach((_, id) => {
    const sec = document.getElementById(id);
    if (sec) spy.observe(sec);
  });
</script>
