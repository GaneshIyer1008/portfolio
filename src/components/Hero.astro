---
import { Image } from 'astro:assets';
import portrait from '../assets/ganesh.jpeg';
import { profile } from '../data/profile';
import { withBase } from '../lib/base';
import Socials from './Socials.astro';

const cv = withBase('cv.pdf');
---
<section id="top" class="hero">
  <div class="bg" aria-hidden="true"></div>
  <div class="container hero-inner">
    <div class="hero-text" data-reveal>
      <p class="hello">Hi, I'm</p>
      <h1>{profile.name}</h1>
      <p class="role">{profile.role}</p>
      <p class="intro">{profile.intro}</p>
      <div class="cta">
        <a href="#projects" class="btn btn-primary">View projects</a>
        <a href={cv} class="btn btn-ghost" target="_blank" rel="noopener">Download CV</a>
      </div>
      <Socials size="md" />
    </div>

    <div class="hero-photo" data-reveal>
      <div class="frame">
        <Image
          src={portrait}
          alt="Ganesh Iyer"
          widths={[320, 480, 640]}
          sizes="(max-width: 760px) 72vw, 340px"
          loading="eager"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(3rem, 9vw, 6rem);
    overflow: hidden;
  }
  .bg {
    position: absolute;
    inset: 0 0 auto 0;
    height: 520px;
    background: radial-gradient(70% 80% at 25% 0%, var(--accent-soft), transparent 70%);
    pointer-events: none;
  }
  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.4fr 0.9fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }
  .hello {
    font-family: var(--font-mono);
    color: var(--accent);
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    margin-bottom: 0.4rem;
  }
  .hero h1 {
    font-size: clamp(2.6rem, 7vw, 4.1rem);
    line-height: 1.05;
  }
  .role {
    font-size: clamp(1.1rem, 2.4vw, 1.4rem);
    font-weight: 500;
    color: var(--fg-strong);
    margin-top: 0.7rem;
  }
  .intro {
    color: var(--muted);
    font-size: 1.05rem;
    margin-top: 1rem;
    max-width: 52ch;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-block: 1.6rem 1.4rem;
  }

  .hero-photo { justify-self: center; }
  .frame {
    position: relative;
    width: clamp(220px, 72vw, 340px);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
    background: var(--bg-soft);
  }
  .frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 22%;
  }

  @media (max-width: 760px) {
    .hero-inner { grid-template-columns: 1fr; }
    .hero-photo { grid-row: 1; }
    .frame { width: clamp(200px, 60vw, 260px); }
    .hero-text { text-align: left; }
  }
</style>
