---
import type { Video } from '../data/types';

interface Props {
  video: Video;
}
const { video } = Astro.props;

const isPlaylist = 'playlistId' in video;
const embed = isPlaylist
  ? `https://www.youtube-nocookie.com/embed/videoseries?list=${video.playlistId}&autoplay=1&rel=0`
  : `https://www.youtube-nocookie.com/embed/${video.youtubeId}?autoplay=1&rel=0`;
const posterId = isPlaylist ? video.posterId : video.youtubeId;
const poster = posterId ? `https://i.ytimg.com/vi/${posterId}/hqdefault.jpg` : null;
const label = video.title ?? (isPlaylist ? 'Watch the playlist' : 'Watch the video');
---
<div class="video">
  <button
    class:list={['facade', { 'no-poster': !poster }]}
    data-embed={embed}
    data-title={label}
    style={poster ? `background-image:url('${poster}')` : undefined}
    type="button"
    aria-label={`Play: ${label}`}
  >
    <span class="play" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z" /></svg>
    </span>
    {isPlaylist && <span class="badge">Playlist</span>}
    <span class="vtitle">{label}</span>
  </button>
</div>

<style>
  .video {
    position: relative;
    aspect-ratio: 16 / 9;
    width: 100%;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    background: #000;
  }
  .facade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    cursor: pointer;
    background-color: var(--bg-soft);
    background-size: cover;
    background-position: center;
    display: grid;
    place-items: center;
    color: #fff;
  }
  .facade.no-poster {
    background-image: linear-gradient(135deg, var(--accent), #7c3aed 95%);
  }
  .facade::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.05) 45%);
    transition: background var(--transition);
  }
  .facade:hover::after { background: linear-gradient(to top, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.15) 60%); }
  .play {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.45);
    border: 2px solid rgba(255, 255, 255, 0.9);
    transition: transform var(--transition), background var(--transition);
  }
  .play svg { width: 28px; height: 28px; margin-left: 2px; }
  .facade:hover .play { transform: scale(1.08); background: var(--accent); border-color: var(--accent); }
  .badge {
    position: absolute;
    z-index: 1;
    top: 0.7rem;
    left: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.22rem 0.5rem;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.35);
  }
  .vtitle {
    position: absolute;
    z-index: 1;
    left: 0.9rem;
    right: 0.9rem;
    bottom: 0.7rem;
    font-size: 0.85rem;
    font-weight: 500;
    text-align: left;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6);
  }
  /* dynamically injected iframe */
  .video :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.facade').forEach((btn) => {
    btn.addEventListener('click', () => {
      const src = btn.getAttribute('data-embed');
      if (!src) return;
      const iframe = document.createElement('iframe');
      iframe.src = src;
      iframe.title = btn.getAttribute('data-title') || 'Video';
      iframe.loading = 'lazy';
      iframe.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      btn.replaceWith(iframe);
    });
  });
</script>
