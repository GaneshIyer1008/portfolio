---
import Section from './Section.astro';
import VideoEmbed from './VideoEmbed.astro';
import { experience } from '../data/experience';
---
<Section
  id="experience"
  eyebrow="02 — Experience"
  title="Experience & research"
  subtitle="Where I've put robot learning and planning to work."
  alt
>
  <div class="xp">
    {
      experience.map((x) => {
        const hasMedia = Boolean(x.video || x.videoSoon);
        return (
          <article class:list={['card item', { 'item--solo': !hasMedia }]} data-reveal>
            <div class="text">
              <header>
                <h3>{x.role}</h3>
                <p class="org">
                  {x.orgUrl ? (
                    <a href={x.orgUrl} target="_blank" rel="noopener">{x.org}</a>
                  ) : (
                    x.org
                  )}
                  {x.location && <span class="loc"> · {x.location}</span>}
                </p>
                {x.advisor && (
                  <p class="advisor">
                    Advisor:{' '}
                    {x.advisor.href ? (
                      <a href={x.advisor.href} target="_blank" rel="noopener">{x.advisor.name}</a>
                    ) : (
                      x.advisor.name
                    )}
                  </p>
                )}
                <span class="period">{x.period}</span>
              </header>

              <ul class="highlights">
                {x.highlights.map((h) => <li>{h}</li>)}
              </ul>

              <div class="tags">
                {x.tags.map((t) => <span class="tag">{t}</span>)}
              </div>

              {x.links && (
                <div class="links">
                  {x.links.map((l) => (
                    <a href={l.href} target="_blank" rel="noopener" class="link">{l.label} ↗</a>
                  ))}
                </div>
              )}
            </div>

            {hasMedia && (
              <div class="media">
                {x.video ? (
                  <VideoEmbed video={x.video} />
                ) : (
                  <div class="soon"><span>🎬 Video coming soon</span></div>
                )}
              </div>
            )}
          </article>
        );
      })
    }
  </div>
</Section>

<style>
  .xp { display: grid; gap: 1.4rem; }
  .item {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.2rem, 3vw, 2rem);
    padding: clamp(1.3rem, 3vw, 1.8rem);
    align-items: center;
  }
  .item--solo { grid-template-columns: 1fr; }

  h3 { font-size: 1.2rem; }
  .org { margin-top: 0.25rem; font-weight: 500; color: var(--fg-strong); }
  .loc { color: var(--muted); font-weight: 400; }
  .advisor { font-size: 0.9rem; color: var(--muted); margin-top: 0.15rem; }
  .period {
    display: inline-block;
    margin-top: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--accent);
  }

  .highlights { list-style: none; margin-top: 1rem; display: grid; gap: 0.55rem; }
  .highlights li {
    position: relative;
    padding-left: 1.3rem;
    font-size: 0.95rem;
    color: var(--muted);
  }
  .highlights li::before {
    content: '';
    position: absolute;
    left: 0.1rem;
    top: 0.62em;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--accent);
  }

  .tags { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-top: 1.1rem; }
  .links { margin-top: 1rem; display: flex; flex-wrap: wrap; gap: 1rem; }
  .link { font-size: 0.9rem; font-weight: 500; }

  .soon {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    border: 1px dashed var(--border-strong);
    background: var(--bg-soft);
    color: var(--muted);
    font-size: 0.9rem;
  }

  @media (max-width: 820px) {
    .item, .item--solo { grid-template-columns: 1fr; }
    .media { order: -1; }
  }
</style>
