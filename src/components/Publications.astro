---
import Section from './Section.astro';
import { publications, me } from '../data/publications';
import { profile } from '../data/profile';

const pubs = publications.map((p) => ({ ...p, parts: p.authors.split(me) }));
---
<Section
  id="publications"
  eyebrow="04 — Publications"
  title="Publications"
  subtitle="Peer-reviewed research."
  alt
>
  <ul class="pubs">
    {
      pubs.map((p) => (
        <li class="card pub" data-reveal>
          <div class="head">
            <h3>{p.title}</h3>
            {p.status && <span class="status">{p.status}</span>}
          </div>
          <p class="authors">
            {p.parts.map((part, i) => (
              <>
                {part}
                {i < p.parts.length - 1 && <strong>{me}</strong>}
              </>
            ))}
          </p>
          <p class="venue"><em>{p.venue}</em> · {p.year}</p>
          <div class="links">
            {p.links.map((l) => (
              <a href={l.href} class="pill" target="_blank" rel="noopener">{l.label} ↗</a>
            ))}
          </div>
        </li>
      ))
    }
  </ul>

  <p class="more" data-reveal>
    Full list on <a href={profile.socials.scholar} target="_blank" rel="noopener">Google Scholar ↗</a>
  </p>
</Section>

<style>
  .pubs { list-style: none; display: grid; gap: 1.1rem; }
  .pub { padding: 1.3rem 1.5rem; border-left: 3px solid var(--accent); }
  .head { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }
  .pub h3 { font-size: 1.12rem; line-height: 1.3; }
  .status {
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    padding: 0.25rem 0.55rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
  }
  .authors { color: var(--muted); margin-top: 0.6rem; font-size: 0.95rem; }
  .authors strong { color: var(--fg-strong); }
  .venue { margin-top: 0.3rem; font-size: 0.95rem; }
  .links { margin-top: 0.9rem; display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .pill {
    font-size: 0.85rem;
    font-weight: 500;
    padding: 0.32rem 0.75rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
  }
  .pill:hover { border-color: var(--accent); }
  .more { margin-top: 1.4rem; color: var(--muted); font-size: 0.95rem; }
</style>
