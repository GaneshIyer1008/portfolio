---
import Section from './Section.astro';
import { achievements } from '../data/achievements';
---
<Section id="achievements" eyebrow="06 — Honors" title="Achievements & honors" alt>
  <ul class="list">
    {
      achievements.map((a) => (
        <li class="row" data-reveal>
          <span class="yr">{a.year}</span>
          <span class="txt">{a.text}</span>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .list { list-style: none; display: grid; gap: 0.2rem; max-width: 820px; }
  .row {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 1rem;
    align-items: baseline;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--border);
  }
  .row:last-child { border-bottom: 0; }
  .yr {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--accent);
    font-weight: 500;
  }
  .txt { color: var(--fg); }

  @media (max-width: 540px) {
    .row { grid-template-columns: 52px 1fr; gap: 0.7rem; }
  }
</style>
