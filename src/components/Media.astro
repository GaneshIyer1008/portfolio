---
import VideoEmbed from './VideoEmbed.astro';
import { withBase } from '../lib/base';
import type { Video } from '../data/types';

interface Props {
  video?: Video;
  image?: string; // filename in public/ (e.g. 'voronoi.png')
  alt?: string;
  videoSoon?: boolean;
}
const { video, image, alt = '', videoSoon } = Astro.props;
---
{
  video ? (
    <VideoEmbed video={video} />
  ) : image ? (
    <a class="img-frame" href={withBase(image)} target="_blank" rel="noopener" aria-label="Open full-size image">
      <img src={withBase(image)} alt={alt} loading="lazy" width="1920" height="1080" />
    </a>
  ) : videoSoon ? (
    <div class="soon"><span>🎬 Video coming soon</span></div>
  ) : null
}

<style>
  .img-frame {
    display: block;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg-soft);
    cursor: zoom-in;
  }
  .img-frame img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform var(--transition);
  }
  .img-frame:hover img { transform: scale(1.02); }

  .soon {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    border: 1px dashed var(--border-strong);
    background: var(--bg-soft);
    color: var(--muted);
    font-size: 0.9rem;
  }
</style>
